             private bool wel, fourByte;
 
             private static readonly byte[] Empty = new byte[0];
-            private static readonly byte[] Jedec = { 0xC2, 0x20, 0x18 };
+            // Not `= { 0xC2, 0x20, 0x18 }`. The Mono compiler turns a static
+            // byte-array initializer into a data blob and names it with
+            // Mono.Security.Cryptography.CryptoConvert.ToHex. Renode's Windows
+            // package does not ship Mono.Security, so that initializer aborts
+            // the compile and the monitor prints only a source location.
+            private static readonly byte[] Jedec = MakeJedec();
+
+            private static byte[] MakeJedec()
+            {
+                var id = new byte[3];
+                id[0] = 0xC2;
+                id[1] = 0x20;
+                id[2] = 0x18;
+                return id;
+            }
 
             private const uint RSTEN = 0x66, RST = 0x99, WRDI = 0x04, WREN = 0x06;
